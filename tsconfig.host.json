{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/host/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "src/asset-library/host/**/*",
    "src/asset-library/shared/**/*.ts",
    "src/index.ts"
  ]
}
